# ── 한국투자증권 Open API (https://apiportal.koreainvestment.com) ──
# 모의투자용 앱키/시크릿으로 먼저 시작하세요 (KIS_ENV=paper). 실전 키는 실전용 키를 따로 발급.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ENV=paper            # paper | real

# ── Claude ──
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5     # 더 싸게: claude-sonnet-5-5
CLAUDE_EFFORT=low                # low | medium | high  (알림은 빠른 low 권장)
CLAUDE_TIMEOUT_SEC=25            # 초과하면 의견 없이 신호만 먼저 알림
MAX_CLAUDE_CALLS_PER_HOUR=30     # 비용 안전장치

# ── 텔레그램 (@BotFather 로 봇 생성 → 토큰, @userinfobot 으로 chat_id 확인) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 감시 종목 (최대 41개)  코드:이름,코드:이름 ──
WATCHLIST=005930:삼성전자,000660:SK하이닉스

# ── 신호 조건 (기본값) ──
SURGE_PCT=5              # 전일 대비 ±5%, ±10%, ±15% … 단계를 처음 넘을 때마다 1회
VOLUME_MULT=2            # 누적거래량 ≥ 20일 평균 일거래량 × 2
MA_WINDOW=20             # 이동평균 기간 (일)
MA_BUFFER_PCT=0.2        # 이평선 돌파 판정 여유 %
COOLDOWN_MIN=30          # 거래량/이평선 신호 재발동 대기 (분)
MAX_ALERTS_PER_SYMBOL_DAY=6
ACTIVE_FROM=090000       # 이 시간 밖의 틱으로는 신호를 내지 않음
ACTIVE_TO=152000         # 15:20 이후 동시호가 제외

# STATE_DIR=.state       # 토큰 캐시 위치
